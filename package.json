    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.1",
    "web-ifc": "^0.0.78"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
